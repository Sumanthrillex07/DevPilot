# ============================================================
# DevPilot Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in the values for local run.
# Do NOT commit .env with real secrets to version control.
# ============================================================

# Database Configuration (PostgreSQL + pgvector)
DEVPILOT_DB_HOST=localhost
DEVPILOT_DB_PORT=5433
DEVPILOT_DB_NAME=devpilot
DEVPILOT_DB_USERNAME=postgres
DEVPILOT_DB_PASSWORD=postgres

# Frontend & CORS Configuration
DEVPILOT_FRONTEND_URL=http://localhost:5173
DEVPILOT_CORS_ALLOWED_ORIGINS=http://localhost:5173

# GitHub OAuth2 (Required starting in Part 3)
DEVPILOT_GITHUB_CLIENT_ID=your-github-client-id
DEVPILOT_GITHUB_CLIENT_SECRET=your-github-client-secret

# Encryption Secrets (Required starting in Part 3)
DEVPILOT_TOKEN_ENCRYPTOR_PASSWORD=your-secret-encryption-password-min-16-chars
DEVPILOT_TOKEN_ENCRYPTOR_SALT=a1b2c3d4e5f60718

# OpenAI API Key (Required starting in Part 6 for embeddings & RAG)
OPENAI_API_KEY=sk-...
